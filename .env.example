# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: The Gemini model ID to use for vision analysis and health checks.
# Default recommendation: "gemini-3.8-flash"
GEMINI_MODEL="gemini-3.8-flash"

# HEALTH_CHECK_SECRET: Optional diagnostic access secret to restrict /api/health queries.
# If configured, send header 'x-health-key' or query param '?key=YOUR_SECRET'.
HEALTH_CHECK_SECRET="optional_diagnostic_secret"

# VITE_PUBLIC_SITE_URL: The public canonical website URL for PokéLook (e.g., https://pokelook.vercel.app).
# Used by Disqus to anchor the discussion thread across all environments.
# Never contains any secrets or API keys.
VITE_PUBLIC_SITE_URL="https://pokelook.vercel.app"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
